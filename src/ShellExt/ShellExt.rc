#include <windows.h>
#include "resource.h"

IDI_CONVERT ICON "convert.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Pedro Paulo Vezza Campos"
            VALUE "FileDescription",  "HEIC to JPEG Explorer context menu"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ShellExt"
            VALUE "OriginalFilename", "HeicToJpegShellExt.dll"
            VALUE "ProductName",      "HEIC to JPEG"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
